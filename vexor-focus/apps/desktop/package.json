{
  "name": "@team-vexor/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "node-sqlite3-wasm": "^0.8.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "studio.teamvexor.focus",
    "productName": "Vexor Focus",
    "files": [
      "src/**/*",
      "team-vexor.png"
    ],
    "buildDependenciesFromSource": true,
  "asar": true,
  "asarUnpack": [
    "**/node-sqlite3-wasm/**"
  ],
  "win": {
    "target": ["portable", "nsis"]
  }
  }
}
